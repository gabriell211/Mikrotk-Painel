# Login do painel
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-por-uma-senha-forte
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes

# MikroTik RouterOS REST API
# Use HTTPS e um endereço que seja alcançável pela Vercel.
# Não exponha a API REST do MikroTik diretamente na Internet sem VPN/túnel/restrições.
MIKROTIK_URL=https://router.exemplo.com
MIKROTIK_USUARIO=painel-web
MIKROTIK_SENHA=troque-esta-senha
MIKROTIK_TIMEOUT_MS=10000

# Segurança operacional
PAINEL_MODO_SOMENTE_LEITURA=false
MIKROTIK_AUTO_EXPORT=false
MIKROTIK_PERMITIR_HTTP=false

# Opcional: restringe chamadas mutáveis à origem exata do painel
# Exemplo: https://mikrotk-painel.vercel.app
ORIGEM_PERMITIDA=
